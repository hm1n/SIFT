# Sentry 브라우저 계측(이슈 #81)
#
# Sentry 프로젝트의 클라이언트 DSN입니다. 이 값이 없으면 `Sentry.init`을 부르지 않으므로 로컬
# 개발과 테스트에서 이벤트가 나가지 않습니다. 값을 넣으면 Core Web Vitals와 클라이언트 런타임
# 오류가 Sentry로 갑니다.
#
# `NEXT_PUBLIC_` 접두사가 붙은 값은 Next.js가 빌드 시점에 클라이언트 번들로 인라인합니다.
# 런타임 환경변수로 주입해도 브라우저가 읽지 못하므로 빌드 파이프라인에 있어야 합니다.
NEXT_PUBLIC_SENTRY_DSN=

# 이 파일에는 아직 GitHub OAuth와 LLM 관련 환경변수가 없습니다. 이슈 #81 범위가 아니어서
# `llm-wiki/wiki/2026-09-08-sentry-계측-후속-backlog.md` 6번으로 남겼습니다.

# GA4 퍼널 계측(이슈 #125)
#
# GA4 웹 데이터 스트림의 측정 ID입니다(`G-`로 시작합니다). 이 값이 없거나 공백이면 gtag 스크립트를
# 아예 싣지 않으므로 네트워크 요청이 일어나지 않고 모든 이벤트 호출이 아무 일도 하지 않습니다.
# 로컬 개발과 테스트의 정상 상태이고 콘솔 경고도 남기지 않습니다.
#
# `NEXT_PUBLIC_` 접두사가 붙은 값은 Next.js가 빌드 시점에 클라이언트 번들로 인라인합니다. 읽는 쪽이
# 브라우저이므로 런타임 주입으로는 동작하지 않고 빌드 파이프라인에 있어야 합니다. 측정 ID는 페이지
# 소스에 그대로 실리는 공개 값이라 번들에 들어가도 무해합니다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GA4 `user_id`를 만드는 HMAC 비밀값입니다. 서버 전용입니다.
#
# GitHub 사용자 번호를 그대로 보내면 GitHub 공개 API로 계정 아이디를 역추적할 수 있어, 금지한 로그인
# 아이디를 함께 보내는 것이 됩니다. 이 값을 섞어 되돌릴 수 없는 해시로 바꿔 보냅니다.
#
# `NEXT_PUBLIC_` 접두사를 붙이면 안 됩니다. 클라이언트 번들에 실려 누구나 같은 해시를 계산할 수 있고
# 변환의 의미가 사라집니다. 값이 바뀌면 같은 사용자가 다른 사람으로 집계되므로 유출 사고가 아닌 한
# 교체하지 않습니다. 비어 있으면 `user_id` 없이 집계합니다.
GA_USER_ID_HMAC_SECRET=

# Neon Postgres 접속(이슈 #114)
#
# Vercel 마켓플레이스에서 Neon을 연결하거나 `neon link`를 실행하면 이 두 값이 주입됩니다. 로컬에서는
# `neon link`가 `.env.local`에 써 주므로 이 파일의 값을 손으로 채울 일은 없습니다.
#
# DATABASE_URL은 연결 풀을 거치는 주소이고 애플리케이션 질의가 씁니다. DATABASE_URL_UNPOOLED는
# 풀을 거치지 않는 주소이고 `npm run db:schema`가 쓰는 DDL 전용입니다. 없으면 DATABASE_URL로
# 내려갑니다.
#
# 표 두 개를 만들려면 값을 채운 뒤 `npm run db:schema`를 실행합니다. 모든 문장이 `if not exists`라
# 여러 번 실행해도 결과가 같습니다.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
